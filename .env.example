# Copy to .env and fill in the session token. .env is gitignored.

# Required: your beta.nomi.ai session cookie. In a logged-in browser, copy the
# value of the __Secure-next-auth.session-token cookie. It expires
# periodically; refresh it here when the log shows auth errors.
NOMI_SESSION_TOKEN=

# Optional: the URL that receives a POST for each incoming Nomi message.
# Leave it unset for console mode, which just prints each message to the log,
# handy for watching it work before wiring up a real destination.
# NOMI_WEBHOOK_URL=https://your-webhook-endpoint

# Optional: only forward messages from these Nomi ids (comma-separated).
# Default: all your Nomis.
# NOMI_NOMI_IDS=2102243547,1626809467

# Optional: forward only proactive/scheduled messages, not replies to you.
# NOMI_PROACTIVE_ONLY=1

# Optional: how long to wait for a message's finalized text (ms).
# NOMI_DEBOUNCE_MS=1500
